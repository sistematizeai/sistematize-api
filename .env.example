PORT=3001
HOST=0.0.0.0
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Email provider: "gmail_api" for Gmail OAuth, "smtp" for Gmail SMTP/app password, or "resend" for Resend.
EMAIL_PROVIDER=gmail_api
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sistematizeai@gmail.com
SMTP_PASS=your-google-app-password
RESEND_API_KEY=
FROM_EMAIL=Sistematize <sistematizeai@gmail.com>
REPLY_TO_EMAIL=sistematizeai@gmail.com

FRONTEND_ADMIN_URL=http://localhost:3100
FRONTEND_DASHBOARD_URL=http://localhost:3200
FRONTEND_PUBLIC_URL=http://localhost:3300

TOTP_ENCRYPTION_KEY=your-32-char-encryption-key
